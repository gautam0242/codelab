# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development            # development | production
SECRET_KEY=                    # REQUIRED in production: long random string (python -c "import secrets;print(secrets.token_hex(32))")
DATABASE_URL=                  # empty = local SQLite file. Hosted: postgresql://user:pass@host/db?sslmode=require

# --- C++ execution ---
EXECUTOR=judge0                # judge0 = external Judge0 service (below) | local = g++ on THIS server (Docker deploy, free, weaker isolation)

# --- Judge0-compatible C++ execution service (only when EXECUTOR=judge0) ---
JUDGE0_URL=                    # RapidAPI: https://judge0-ce.p.rapidapi.com   Self-hosted: http://your-server:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=               # RapidAPI only: judge0-ce.p.rapidapi.com  (leave empty for self-hosted)
JUDGE0_AUTH_HEADER=X-Auth-Token  # self-hosted token header name (Judge0 AUTHN_HEADER)
JUDGE0_LANGUAGE_ID=54          # verify on YOUR service with: python check_executor.py
JUDGE0_USE_WAIT=0              # 1 = one API call per test (saves quota) if your host allows wait=true
JUDGE0_DEADLINE=45
CPU_TIME_LIMIT=2
MEMORY_LIMIT_KB=128000

# --- optional tuning ---
PASTE_DETERRENT=1
SIM_THRESHOLD=0.85
SIM_MIN_TOKENS=25
RATE_RUN_PER_MIN=20
RATE_SUBMIT_PER_MIN=6
LOGIN_MAX_FAILS=5
TRUST_PROXY=                   # defaults to 1 in production (behind Render's proxy)
